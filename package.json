{
  "name": "cairn-browser",
  "version": "0.1.1",
  "description": "Cairn — an agent-first browser automation tool. Act by stable ref, never by coordinate.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wulu-epic/cairn"
  },
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "cairn": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "files": [
    "dist",
    "skills"
  ],
  "agents": {
    "skills": [
      {
        "name": "cairn",
        "path": "./skills/cairn"
      }
    ]
  },
  "dependencies": {
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/expect": "^4.1.10",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
